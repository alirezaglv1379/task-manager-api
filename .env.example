# Copy this file to backend/.env and replace SECRET_KEY before deployment.
ENVIRONMENT=development
APP_NAME=Task Manager API
APP_VERSION=2.0.0
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
DATABASE_URL=sqlite:///./task_manager.db
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=task_manager_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
LOGIN_IP_LIMIT=20
LOGIN_USERNAME_FAILURE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
# Only set these when the direct peer is a reverse proxy you control.
# TRUSTED_PROXY_IPS=127.0.0.1,::1
